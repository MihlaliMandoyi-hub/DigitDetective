<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="DigitDetective.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:DigitDetective"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    Title="Digit Detective">

    <ShellContent
        Title="Welcome"
        ContentTemplate="{DataTemplate local:SplashPage}"
        Route="SplashPage" />

    <ShellContent
        Title="Play"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <ShellContent
        Title="Leaderboard"
        ContentTemplate="{DataTemplate local:LeaderboardPage}"
        Route="LeaderboardPage" />


    <ShellContent
        Title="About"
        ContentTemplate="{DataTemplate local:AboutPage}"
        Route="AboutPage" />

    <ShellContent
        Title="Achievements"
        ContentTemplate="{DataTemplate local:AchievementsPage}"
        Route="AchievementsPage" />

</Shell>